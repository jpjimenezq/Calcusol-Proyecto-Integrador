{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::calcusol-datos-eafit"
    },
    {
      "Sid": "LeerTodoEscribirSilverGold",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::calcusol-datos-eafit/*"
    },
    {
      "Sid": "EscribirSoloSilverGold",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::calcusol-datos-eafit/silver/*",
        "arn:aws:s3:::calcusol-datos-eafit/gold/*",
        "arn:aws:s3:::calcusol-datos-eafit/silver_*",
        "arn:aws:s3:::calcusol-datos-eafit/gold_*"
      ]
    }
  ]
}
